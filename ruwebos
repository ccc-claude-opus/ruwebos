#!/bin/sh
# ruwebos launcher: boots the system in ruvm (or QEMU) and opens a browser on this machine at the home screen.
#   ./ruwebos                       boot, open the browser; quitting it (or Ctrl-C) powers the system off
#   ./ruwebos --headless            boot and keep running until Ctrl-C (use any browser on http://localhost:8700/)
#   ./ruwebos --screenshot home.png boot, render the home screen to a PNG (see --browser), power off
#   ./ruwebos --test                boot, run every app's test (apps/*/test.mjs) through the port forward, power off
#   ./ruwebos --accel tcg [url]     force an accelerator (default: hvf on macOS/arm64, kvm on Linux/aarch64, else tcg)
#   ./ruwebos --qemu                boot in QEMU (qemu-system-aarch64, machine virt) instead of ruvm: same kernel and disks
#   ./ruwebos --memory 8192         the VM's memory in MB (default 2048)
#   ./ruwebos --keyboard always     rubrowser's on-screen keyboard: auto (after a touch; default), always, never
#   ./ruwebos --browser chrome      the browser: chrome (its own profile in out/chrome-profile), firefox (out/firefox-
#                                   profile), safari, rubrowser, or any command (given the URL); default chrome when
#                                   installed, else rubrowser. --screenshot uses chrome or firefox headless, else rubrowser
# Uses ../ruvm and ../rubrowser (or RUVM=..., RUBROWSER=... checkouts, or RUBROWSER_BIN=<binary>); rubrowser is
# built with audio and video (--features media, FFmpeg) into its target/media when FFmpeg is installed.
# The system disk out/system.ext4 is built by image/build.sh on first use; the data disk out/data.ext4
# (DATA_SIZE, default 512m) is created empty and formatted by the system on first boot.
set -e
cd "$(dirname "$0")"
now() { perl -MTime::HiRes=time -e 'printf "%.2f", time'; }
since() { perl -e "printf '%.2f', $(now) - $1"; }
t0=$(now)

accel= mode=window shot= url=http://localhost:8700/ vm=ruvm memory=2048 keyboard=auto browser=
while [ $# -gt 0 ]; do
    case "$1" in
        --accel | -accel) accel=$2; shift ;;
        --headless) mode=headless ;;
        --screenshot) mode=screenshot shot=$2; shift ;;
        --test) mode=test ;;
        --qemu) vm=qemu ;;
        --memory) memory=$2; shift ;;
        --keyboard) keyboard=$2; shift ;;
        --browser) browser=$2; shift ;;
        -h | --help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "ruwebos: unknown option $1" >&2; exit 2 ;;
        *) url=$1 ;;
    esac
    shift
done
if [ -z "$accel" ]; then
    case "$(uname -s)-$(uname -m)" in
        Darwin-arm64) accel=hvf ;;
        Linux-aarch64) if [ -w /dev/kvm ]; then accel=kvm; else accel=tcg; fi ;;
        *) accel=tcg ;;
    esac
fi

case $memory in *[!0-9]* | "") echo "ruwebos: --memory takes megabytes, e.g. 8192" >&2; exit 2 ;; esac
# the guest kernel and initramfs come from ruvm's checkout (also when booting in QEMU)
ruvm_dir=${RUVM:-../ruvm}
ruvm=$ruvm_dir/target/release/ruvm
kernel=$ruvm_dir/tests/guest/out/linux/debian/arm64/linux
initrd=$ruvm_dir/tests/guest/out/linux/root/arm64/initramfs.cpio.gz
if [ $vm = qemu ]; then
    qemu=${QEMU:-$(command -v qemu-system-aarch64 || true)}
    [ -n "$qemu" ] || { echo "ruwebos: qemu-system-aarch64 not found (e.g. brew install qemu, apt install qemu-system-arm)" >&2; exit 1; }
    [ -f "$kernel" ] && [ -f "$initrd" ] || { echo "ruwebos: the guest kernel and initramfs are built in ruvm ($kernel)" >&2; exit 1; }
else
    [ -x "$ruvm" ] || { echo "ruwebos: $ruvm not found; build it (cargo build --release in $ruvm_dir)" >&2; exit 1; }
fi
# the browser: Chrome / Firefox (each with a profile of its own, so the everyday one is not touched), Safari,
# rubrowser, or a command. Chrome and *.localhost: Chrome, Firefox and macOS resolve them to this machine.
find_app() { # find_app <macOS app name> <commands to try on PATH...>
    app="/Applications/$1.app/Contents/MacOS"
    case $1 in "Google Chrome") exe="$app/Google Chrome" ;; Firefox) exe="$app/firefox" ;; *) exe= ;; esac
    [ -n "$exe" ] && [ -x "$exe" ] && { echo "$exe"; return; }
    shift
    for c in "$@"; do command -v "$c" 2>/dev/null && return; done
    return 0 # not found: empty (set -e must not stop the launcher)
}
chrome=$(find_app "Google Chrome" google-chrome google-chrome-stable chromium chromium-browser)
firefox=$(find_app Firefox firefox)
if [ -z "$browser" ]; then
    if [ -n "$chrome" ]; then browser=chrome; else browser=rubrowser; fi
fi
case $browser in
    chrome) [ -n "$chrome" ] || { echo "ruwebos: Chrome (or Chromium) not found" >&2; exit 1; } ;;
    firefox) [ -n "$firefox" ] || { echo "ruwebos: Firefox not found" >&2; exit 1; } ;;
    safari) [ "$(uname -s)" = Darwin ] || { echo "ruwebos: Safari is only on macOS" >&2; exit 1; } ;;
esac
# headless screenshots: Chrome or Firefox can take them; otherwise rubrowser does
shooter=rubrowser
[ "$browser" = chrome ] && shooter=chrome
[ "$browser" = firefox ] && shooter=firefox
if { [ "$mode" = window ] && [ "$browser" = rubrowser ]; } || { [ "$mode" = screenshot ] && [ $shooter = rubrowser ]; }; then
    # rubrowser with audio and video (feature `media`, FFmpeg) in its own target dir; built once when
    # FFmpeg's libraries are installed, else the plain release build (media elements then report an error)
    rb_dir=${RUBROWSER:-../rubrowser}
    rubrowser=${RUBROWSER_BIN:-}
    media=$rb_dir/target/media/release/rubrowser
    if [ -z "$rubrowser" ] && [ ! -x "$media" ] && [ -f "$rb_dir/Cargo.toml" ] && pkg-config --exists libavcodec libavformat 2>/dev/null; then
        echo "ruwebos: building rubrowser with audio and video (once, a few minutes)"
        (cd "$rb_dir" && cargo build -q --release --features media --target-dir target/media) || true
    fi
    for b in "$media" "$rb_dir/target/release/rubrowser" "$rb_dir/target/debug/rubrowser" "$(command -v rubrowser || true)"; do
        [ -z "$rubrowser" ] && [ -x "$b" ] && rubrowser=$b
    done
    [ -n "$rubrowser" ] || { echo "ruwebos: rubrowser not found; build it (cargo build --release in $rb_dir) or set RUBROWSER_BIN" >&2; exit 1; }
    [ "$rubrowser" = "$media" ] || echo "ruwebos: $rubrowser cannot play audio or video (install FFmpeg 8, e.g. brew install ffmpeg: the next launch builds it)" >&2
fi
[ -f out/system.ext4 ] || image/build.sh
[ -f out/data.ext4 ] || dd if=/dev/zero of=out/data.ext4 bs=1 count=0 seek="${DATA_SIZE:-512m}" 2>/dev/null
if curl -s -o /dev/null --max-time 1 http://127.0.0.1:8700/; then
    echo "ruwebos: port 8700 is already in use (is ruwebos already running?)" >&2
    exit 1
fi

# the host's time zone becomes the system's (the apps show times in it)
tz=${TZ:-$(readlink /etc/localtime 2>/dev/null | sed -n 's|.*zoneinfo/||p')}
case $tz in *[!A-Za-z0-9_/+-]* | "") tz=UTC ;; esac

run=out/run
mkdir -p $run
console=$run/console.in log=$run/console.log
[ -p $console ] || mkfifo $console
pid=

# runs in the background (boot); exec, so that $! is the VM itself
start_vm() {
    append="console=ttyAMA0 rdinit=/init quiet ruwebos.tz=$tz"
    if [ $vm = qemu ]; then
        # machine virt with virtio-mmio devices (the initramfs has no PCI drivers). QEMU hands out the
        # virtio-mmio slots last-first, so the data disk comes before the system disk to get /dev/vdb.
        cpu="-cpu host -smp 4" && [ "$1" = tcg ] && cpu="-cpu max -smp 4"
        # shellcheck disable=SC2086
        exec "$qemu" -M virt -accel "$1" $cpu -m "$memory" -display none -monitor none -serial stdio \
            -kernel "$kernel" -initrd "$initrd" -append "$append" \
            -netdev user,id=net,hostfwd=tcp::8700-:8700 -device virtio-net-device,netdev=net \
            -object rng-random,id=rng,filename=/dev/urandom -device virtio-rng-device,rng=rng \
            -drive if=none,id=data,file=out/data.ext4,format=raw -device virtio-blk-device,drive=data \
            -drive if=none,id=sys,file=out/system.ext4,format=raw,snapshot=on -device virtio-blk-device,drive=sys
    else
        # shellcheck disable=SC2046
        exec "$ruvm" -M aarch64 -m "$memory" $([ "$1" = tcg ] || echo "-accel $1 -smp 4") \
            -kernel "$kernel" -initrd "$initrd" \
            -drive file=out/system.ext4,snapshot=on -drive file=out/data.ext4 \
            -rng -nic user,hostfwd=tcp::8700-:8700 -serial stdio -append "$append"
    fi
}

boot() {
    start_vm "$1" <$console >$log 2>&1 &
    pid=$!
    exec 3>$console # the guest reads its commands (poweroff) from here
    # ready = the guest says so on the console and the home screen answers through the port forward
    # (polling with curl alone is slower: the forward accepts before the guest listens)
    i=0
    until grep -q RUWEBOS-READY $log && curl -s -o /dev/null --max-time 5 http://127.0.0.1:8700/; do
        kill -0 $pid 2>/dev/null || return 1
        i=$((i + 1))
        [ $i -lt 2400 ] || return 1
        perl -e 'select(undef, undef, undef, 0.05)'
    done
}

poweroff() {
    trap - INT TERM
    [ -n "$pid" ] || return 0
    echo poweroff >&3 2>/dev/null || true
    i=0
    while kill -0 $pid 2>/dev/null && [ $i -lt 100 ]; do perl -e 'select(undef, undef, undef, 0.1)'; i=$((i + 1)); done
    kill -0 $pid 2>/dev/null && kill $pid
    wait $pid 2>/dev/null || true
    exec 3>&-
    pid=
    grep -h 'powered off' $log || echo "ruwebos: $vm stopped"
}
trap 'poweroff; exit 130' INT TERM

if ! boot "$accel"; then
    echo "ruwebos: -accel $accel did not boot:" >&2
    tail -n 5 $log >&2
    kill $pid 2>/dev/null || true
    exec 3>&-
    [ "$accel" != tcg ] || exit 1
    echo "ruwebos: falling back to -accel tcg" >&2
    accel=tcg
    boot tcg || { tail -n 20 $log >&2; exit 1; }
fi
grep -h '^== ruwebos' $log || true
echo "ruwebos: ready after $(since "$t0") s ($vm, -accel $accel, $memory MB), $url"

# rubrowser shows an Install button on pages that declare an app package, opening the installer
installer=http://installer.localhost:8700/

case $mode in
    headless)
        echo "ruwebos: Ctrl-C to power off"
        wait $pid || true
        ;;
    screenshot)
        case "$shot" in /*) abs=$shot ;; *) abs=$PWD/$shot ;; esac
        case $shooter in
            chrome)
                # headless Chrome writes the PNG but does not always exit afterwards: wait for the file, then stop it
                rm -f "$abs"
                "$chrome" --headless=new --user-data-dir="$PWD/out/chrome-profile" --hide-scrollbars --window-size=1280,800 \
                    --virtual-time-budget=5000 --screenshot="$abs" "$url" >/dev/null 2>&1 &
                cpid=$! i=0
                until [ -s "$abs" ] || ! kill -0 $cpid 2>/dev/null || [ $i -ge 600 ]; do
                    perl -e 'select(undef, undef, undef, 0.1)'; i=$((i + 1))
                done
                perl -e 'select(undef, undef, undef, 0.3)' # let it finish writing
                kill $cpid 2>/dev/null || true
                wait $cpid 2>/dev/null || true ;;
            firefox)
                mkdir -p out/firefox-profile
                "$firefox" --headless --profile "$PWD/out/firefox-profile" --window-size=1280,800 --screenshot "$abs" "$url" >/dev/null 2>&1 ;;
            *) "$rubrowser" --installer "$installer" --keyboard "$keyboard" --screenshot "$shot" --width 1280 --height 800 "$url" ;;
        esac
        echo "ruwebos: $shot rendered with $shooter $(since "$t0") s after the launch"
        poweroff
        ;;
    window)
        # each waits until the browser quits (for Chrome and Firefox: quit the app, e.g. Cmd-Q)
        case $browser in
            rubrowser) "$rubrowser" --installer "$installer" --keyboard "$keyboard" "$url" || true ;;
            chrome)
                # a normal window (back, address bar, tabs), not --app, which has no toolbar
                "$chrome" --user-data-dir="$PWD/out/chrome-profile" --no-first-run --no-default-browser-check \
                    --window-size=1280,900 --new-window "$url" >/dev/null 2>&1 || true ;;
            firefox)
                mkdir -p out/firefox-profile
                "$firefox" --new-instance --profile "$PWD/out/firefox-profile" "$url" >/dev/null 2>&1 || true ;;
            safari) open -W -a Safari "$url" || true ;;
            *) sh -c "$browser \"\$1\"" ruwebos "$url" || true ;;
        esac
        poweroff
        ;;
    test)
        status=0
        node apps/test.mjs http://localhost:8700 || status=$?
        poweroff
        exit $status
        ;;
esac
